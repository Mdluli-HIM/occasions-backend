# --- Database ---
# Local/dev: your local Postgres connection string.
# Production (Neon): use the POOLED connection string (has "-pooler" in the
# hostname) — Neon's serverless Postgres needs pooling once you have more
# than a handful of concurrent requests, or Prisma will exhaust the
# connection limit. Find it in the Neon dashboard → Connection Details →
# toggle "Pooled connection".
DATABASE_URL="postgresql://user:password@host:5432/occasions?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
# Local dev: http://localhost:3000
# Production: your real Vercel URL, e.g. https://occasions.vercel.app
CORS_ORIGIN="http://localhost:3000"

# MUST be the exact same value as NEXTAUTH_SECRET in the frontend's .env.local
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret-shared-with-the-frontend"

# --- Media storage ---
# "local" (default) writes to ./uploads on disk — fine for local dev, but
# breaks in production (most hosts wipe the filesystem on every deploy/restart).
# "r2" uploads to Cloudflare R2 instead — required for production.
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=occasions-media
# The bucket's public dev URL (Cloudflare dashboard → R2 → bucket → Settings
# → "Public access") or a custom domain you've mapped to the bucket, e.g.
# https://media.occasions.co.za — no trailing slash.
R2_PUBLIC_URL=
